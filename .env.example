# Copy to .env for Docker Compose. Never commit real credentials.
APP_MODE=demo
# auto: demo fixture in demo mode, OpenAI in live mode.
# Explicit openai also allows local testing with demo login and real API calls.
LLM_PROVIDER=auto
WEB_PORT=8080
# Set an externally reachable HTTPS origin before issuing QR-bearing PDFs outside localhost.
PUBLIC_BASE_URL=http://localhost:8080
POSTGRES_PASSWORD=medhub-local-demo
JWT_SECRET=
DOCTOR_USERNAME=doctor
DOCTOR_PASSWORD_HASH=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
AUDIO_RETENTION_DAYS=7
MAX_UPLOAD_MB=50
CORS_ORIGINS=["http://localhost:8080","http://localhost:5173"]
# Local API defaults to SQLite. Compose sets PostgreSQL instead.
DATABASE_URL=sqlite:///./storage/medhub.db
AUDIO_STORAGE_DIR=./storage/audio
# Optional outside the checkout:
# TEMPLATES_DIR=/absolute/path/to/templates
# DIAGNOSES_CSV=/absolute/path/to/ref_disability_diagnoses_202609301227.csv
# TLS override: a directory containing fullchain.pem and privkey.pem.
# TLS_CERT_DIR=/absolute/path/to/certificates
# BIND_ADDRESS=127.0.0.1
